# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# storage local driver (SF-5, review P2): driver local ghi upload vào
# public/{path} — vd public/audio/level-3/unit-9/... CÂY public/audio là
# COMMITTED (demo audio SF-2) nên không ignore được — upload test
# (unit >= 90) dọn tay sau khi chạy E2E/verify

# playwright (SF-5) — trace/artifact của test runs
/test-results
/playwright-report

# typescript
*.tsbuildinfo
next-env.d.ts

# env: giữ .env.example trong repo
!.env.example
test-results/
docs/superpowers/navigator/
