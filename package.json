{
  "name": "ilec-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:audit": "vitest run --config vitest.audit.config.ts",
    "test:sf3": "vitest run --config vitest.sf3.config.ts",
    "test:coverage": "vitest run --coverage",
    "admin:create": "node scripts/create-admin.ts",
    "audio:sync": "node scripts/audio-sync.ts",
    "test:e2e": "playwright test --config playwright.admin.config.ts",
    "test:e2e:sf3": "playwright test --config playwright.sf3.config.ts",
    "test:e2e:sf4": "playwright test --config playwright.sf4.config.ts",
    "test:e2e:vocabulary": "playwright test --config playwright.vocabulary.config.ts",
    "test:e2e:vocabulary-review": "playwright test --config playwright.vocabulary-review.config.ts",
    "test:e2e:dictation": "playwright test",
    "test:e2e:vocabulary-quiz": "playwright test --config playwright.vocabulary-quiz.config.ts",
    "test:e2e:vocabulary-lookup": "playwright test --config playwright.vocabulary-lookup.config.ts",
    "test:e2e:vocabulary-hub": "playwright test --config playwright.vocabulary-hub.config.ts",
    "test:e2e:vocabulary-hub-quiz": "playwright test --config playwright.vocabulary-hub-quiz.config.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "node-html-parser": "9.0.4",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
