{
  "name": "ilec-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:audit": "vitest run --config vitest.audit.config.ts",
    "test:sf3": "vitest run --config vitest.sf3.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:sf1": "vitest run --config vitest.sf1.config.ts",
    "test:store": "vitest run src/lib/oxford/store.integration.test.ts",
    "admin:create": "node scripts/create-admin.ts",
    "audio:sync": "node scripts/audio-sync.ts",
    "crawl:oxford": "node scripts/oxford-crawl.ts",
    "test:e2e:dictation": "playwright test",
