# Database — Neon Postgres (pooled connection string từ console.neon.tech)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth.js — bắt buộc. Sinh: openssl rand -base64 32
AUTH_SECRET=
# Cho phép host động (Vercel preview + local dev)
AUTH_TRUST_HOST=true

# Google OAuth (login Google end-to-end) — console.cloud.google.com
# Redirect URI: {SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site URL công khai (canonical/OAuth redirect sau deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob — prod driver cho lib/storage.ts (bỏ trống = driver local public/uploads, chỉ dev)
BLOB_READ_WRITE_TOKEN=

# Admin local — CHỈ cho `npm run admin:create` + e2e global-setup (password ≥ 8).
# KHÔNG set trên Vercel: admin tạo bằng admin:create chạy local với DATABASE_URL prod.
ADMIN_EMAIL=
ADMIN_PASSWORD=
